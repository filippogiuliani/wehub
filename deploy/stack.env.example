# ===== Family apps stack – variables (Portainer: Environment variables → Load from .env file) =====
# Never commit the filled-in copy: it holds secrets.

TZ=Europe/Rome
# Folder of the host holding the data of the four apps (wehub/, dotrack/, eatrack/, patrack/ are created inside)
DATA_ROOT=/srv/family

# Public addresses (HTTPS, through your reverse proxy) and the host ports it forwards to
WEHUB_URL=https://wehub.example.com
DOTRACK_URL=https://dotrack.example.com
EATRACK_URL=https://eatrack.example.com
PATRACK_URL=https://patrack.example.com
WEHUB_PORT=3004
DOTRACK_PORT=3001
EATRACK_PORT=3000
PATRACK_PORT=3002

# Pocket ID: one OIDC client per app. Callback URL of each: <APP_URL>/api/oidc/pocketid/callback
POCKETID_ISSUER=https://id.example.com
WEHUB_OIDC_ID=
WEHUB_OIDC_SECRET=
DOTRACK_OIDC_ID=
DOTRACK_OIDC_SECRET=
EATRACK_OIDC_ID=
EATRACK_OIDC_SECRET=
PATRACK_OIDC_ID=
PATRACK_OIDC_SECRET=

# Keys between weHub and each app (different from each other). Make each with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
DOTRACK_HUB_KEY=
EATRACK_HUB_KEY=
PATRACK_HUB_KEY=

# Email sent by the apps (address confirmation, reminders, paTrack import summaries)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
DOTRACK_REMINDER_HOUR=8

# paTrack import by email (leave empty to turn it off)
PATRACK_INBOX_ADDRESS=
PATRACK_IMAP_HOST=
PATRACK_IMAP_PORT=993
PATRACK_IMAP_USER=
PATRACK_IMAP_PASSWORD=
PATRACK_IMAP_DONE_FOLDER=
