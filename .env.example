# ===== weHub – configuration =====
WEHUB_URL=https://wehub.example.com
TZ=Europe/Rome
WEHUB_COOKIE_SECURE=1
WEHUB_PROXY=1

# Sign-in: Pocket ID. Callback URL to register: <WEHUB_URL>/api/oidc/pocketid/callback
WEHUB_OIDC=pocketid
WEHUB_OIDC_POCKETID_ISSUER=https://id.example.com
WEHUB_OIDC_POCKETID_ID=
WEHUB_OIDC_POCKETID_SECRET=
WEHUB_OIDC_POCKETID_NAME=Pocket ID
# Password sign-in: only for a first try before Pocket ID is set up. 0 in production.
WEHUB_PASSWORD_LOGIN=0
# closed (default): only the very first person creates the family; the others are added by an admin
WEHUB_SIGNUP=closed

# The connected apps. Key: `docker exec wehub python manage.py new-key`, the same in the app's *_HUB_KEY
WEHUB_APPS=dotrack,eatrack,patrack
WEHUB_APP_DOTRACK_URL=https://dotrack.example.com
WEHUB_APP_DOTRACK_INTERNAL_URL=
WEHUB_APP_DOTRACK_KEY=
WEHUB_APP_EATRACK_URL=https://eatrack.example.com
WEHUB_APP_EATRACK_INTERNAL_URL=
WEHUB_APP_EATRACK_KEY=
WEHUB_APP_PATRACK_URL=https://patrack.example.com
WEHUB_APP_PATRACK_INTERNAL_URL=
WEHUB_APP_PATRACK_KEY=

# Email (address confirmation). Without SMTP emails are only logged.
WEHUB_SMTP_HOST=
WEHUB_SMTP_PORT=587
WEHUB_SMTP_USER=
WEHUB_SMTP_PASSWORD=
WEHUB_MAIL_FROM=weHub <noreply@example.com>
WEHUB_BACKUP_KEEP=30
